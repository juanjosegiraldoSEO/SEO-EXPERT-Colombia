      <div class="tile"><div class="n warn">35</div><div class="k">Backlinks</div><div class="s">35 dominios de referencia</div></div>
      <div class="tile"><div class="n warn">14</div><div class="k">Visibilidad IA</div><div class="s">1 mención (ChatGPT)</div></div>
