<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PERLAZUL · Auditoría SEO</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Quicksand:wght@400;500;600;700&display=swap">
<style>
  :root{
    --ground:#FBFAF7; --surface:#FFFFFF; --ink:#12232E; --muted:#5C7480;
    --navy:#0A2A3B; --navy-2:#103B50; --pearl:#2E7DA1; --pearl-lt:#6FB0CC;
    --coral:#E0785C; --coral-dp:#C4553D; --sand:#EFE7D9; --line:#E3DED3;
    --good:#2F8F6B; --warn:#C88A2E; --bad:#C4553D;
    --serif:"Cormorant Garamond", Georgia, serif;
    --sans:"Quicksand", -apple-system, "Segoe UI", sans-serif;
    --wrap:1080px;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--ground);color:var(--ink);font-family:var(--sans);
    font-weight:400;line-height:1.65;-webkit-font-smoothing:antialiased;}
  h1,h2,h3,h4{font-family:var(--serif);font-weight:600;line-height:1.08;text-wrap:balance;margin:0}
  p{margin:0 0 1em}
  a{color:var(--pearl);text-decoration:none}
  .wrap{max-width:var(--wrap);margin:0 auto;padding:0 28px}
  .eyebrow{font-family:var(--sans);font-weight:600;font-size:.72rem;letter-spacing:.22em;
    text-transform:uppercase;color:var(--pearl)}
  .lede{font-size:1.18rem;color:var(--muted);max-width:60ch}
  section{padding:76px 0}
  .rule{height:1px;background:var(--line);border:0;margin:0}

  /* Top bar */
  .bar{position:sticky;top:0;z-index:20;background:rgba(251,250,247,.9);
    backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  .bar .wrap{display:flex;align-items:center;justify-content:space-between;height:60px}
  .mark{font-family:var(--serif);font-weight:600;font-size:1.35rem;letter-spacing:.16em}
  .bar .meta{font-size:.74rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}

  /* Hero */
  .hero{background:
      radial-gradient(120% 90% at 85% -10%, rgba(111,176,204,.22), transparent 55%),
      linear-gradient(160deg,var(--navy) 0%, var(--navy-2) 100%);
    color:#EAF2F5;padding:96px 0 84px;position:relative;overflow:hidden}
  .hero .wrap{position:relative;z-index:2}
  .hero .eyebrow{color:var(--pearl-lt)}
  .hero h1{font-size:clamp(2.7rem,6.4vw,4.6rem);color:#F5FAFB;margin:.28em 0 .35em;font-weight:500}
  .hero h1 em{font-style:italic;color:var(--pearl-lt)}
  .hero .lede{color:#B9CED7;font-size:1.24rem;max-width:54ch}
  .wave{position:absolute;inset:auto 0 -2px 0;width:100%;height:80px;display:block;z-index:1;opacity:.5}
  .heroStats{display:flex;flex-wrap:wrap;gap:0;margin-top:44px;
    border:1px solid rgba(255,255,255,.16);border-radius:3px;overflow:hidden;max-width:660px}
  .heroStats div{flex:1 1 0;min-width:150px;padding:18px 22px;border-right:1px solid rgba(255,255,255,.14)}
  .heroStats div:last-child{border-right:0}
  .heroStats .n{font-family:var(--serif);font-size:2.1rem;line-height:1;color:#F5FAFB}
  .heroStats .n.bad{color:var(--coral)}
  .heroStats .k{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:#8FAAB6;margin-top:8px}

  /* section heads */
  .shead{margin-bottom:38px;max-width:64ch}
  .shead h2{font-size:clamp(1.9rem,3.6vw,2.7rem);margin:.2em 0 .35em}
  .shead p{color:var(--muted);margin:0}

  /* big number tiles */
  .tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px;
    background:var(--line);border:1px solid var(--line);border-radius:4px;overflow:hidden}
  .tile{background:var(--surface);padding:26px 22px}
  .tile .n{font-family:var(--serif);font-size:2.6rem;line-height:1;color:var(--ink)}
  .tile .n.bad{color:var(--coral-dp)} .tile .n.warn{color:var(--warn)}
  .tile .k{font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-top:10px}
  .tile .s{font-size:.82rem;color:var(--muted);margin-top:4px}

  .shot{margin-top:34px;border:1px solid var(--line);border-radius:6px;overflow:hidden;
    box-shadow:0 18px 40px -24px rgba(10,42,59,.4);background:#fff}
  .shot img{display:block;width:100%}
  .cap{font-size:.82rem;color:var(--muted);margin-top:10px;font-style:italic}
  .two{display:grid;grid-template-columns:1fr 1fr;gap:26px}
  @media(max-width:760px){.two{grid-template-columns:1fr}}

  /* scores */
  .scoreband{background:var(--navy);color:#EAF2F5}
  .scoreband .shead h2{color:#F5FAFB}.scoreband .shead p{color:#9FBAC6}
  .scoreband .eyebrow{color:var(--pearl-lt)}
  .scores{display:flex;flex-direction:column;gap:12px}
  .srow{display:grid;grid-template-columns:210px 1fr 120px;gap:20px;align-items:center}
  @media(max-width:640px){.srow{grid-template-columns:130px 1fr 74px}}
  .srow .lab{font-weight:600;font-size:.95rem}
  .track{height:9px;background:rgba(255,255,255,.12);border-radius:6px;overflow:hidden}
  .fill{height:100%;border-radius:6px}
  .srow .val{text-align:right;font-family:var(--serif);font-size:1.5rem}
  .sgood{color:#7FD3AE} .swarn{color:#F0C070} .sbad{color:var(--coral)}
  .bg-good{background:linear-gradient(90deg,#2F8F6B,#7FD3AE)}
  .bg-warn{background:linear-gradient(90deg,#C88A2E,#F0C070)}
  .bg-bad{background:linear-gradient(90deg,#C4553D,#E0785C)}

  /* findings */
  .cards{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  @media(max-width:760px){.cards{grid-template-columns:1fr}}
  .card{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:26px;
    border-top:3px solid var(--coral)}
  .card.h{border-top-color:var(--warn)} .card.ok{border-top-color:var(--good)}
  .card .fl{font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:var(--coral-dp)}
  .card.h .fl{color:var(--warn)} .card.ok .fl{color:var(--good)}
  .card h3{font-size:1.5rem;margin:8px 0 8px}
  .card p{font-size:.95rem;color:var(--muted);margin:0}
  .card .metric{font-family:var(--serif);font-size:1.05rem;color:var(--ink);margin-top:12px;font-weight:500}

  /* robots */
  .robots{background:var(--sand)}
  .robots code{font-family:ui-monospace,"SF Mono",Menlo,monospace;background:rgba(10,42,59,.07);
    padding:2px 7px;border-radius:4px;font-size:.85em;color:var(--navy)}
  .rgrid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:26px}
  @media(max-width:700px){.rgrid{grid-template-columns:1fr}}
  .rchip{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:18px 20px}
  .rchip .t{font-weight:600;margin-bottom:4px;display:flex;align-items:center;gap:8px}
  .rchip .t .d{width:8px;height:8px;border-radius:50%;background:var(--good);flex:0 0 auto}
  .rchip p{font-size:.88rem;color:var(--muted);margin:0}

  /* plan phases */
  .plan .shead h2{color:#F5FAFB}
  .phase{display:grid;grid-template-columns:64px 1fr;gap:24px;padding:30px 0;border-top:1px solid rgba(255,255,255,.14)}
  .phase:first-of-type{border-top:0}
  .phase .num{font-family:var(--serif);font-size:2.6rem;color:var(--pearl-lt);line-height:1}
  .phase h3{font-size:1.6rem;color:#F5FAFB;margin-bottom:4px}
  .phase .win{font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;color:var(--pearl-lt);margin-bottom:14px}
  .phase ul{margin:0;padding:0;list-style:none;display:grid;gap:9px}
  .phase li{padding-left:22px;position:relative;color:#C4D7DF;font-size:.96rem}
  .phase li::before{content:"";position:absolute;left:0;top:.62em;width:8px;height:8px;
    border:1.5px solid var(--pearl-lt);border-radius:50%}

  /* KPI table */
  .kpi{width:100%;border-collapse:collapse;font-size:.92rem;margin-top:8px}
  .kpi th,.kpi td{text-align:left;padding:13px 16px;border-bottom:1px solid var(--line)}
  .kpi thead th{font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:700}
  .kpi tbody td:first-child{font-weight:600}
  .kpi .t90{font-family:var(--serif);font-size:1.15rem;color:var(--good)}
  .kpi .base{color:var(--coral-dp);font-weight:600}
  .kpiwrap{overflow-x:auto;border:1px solid var(--line);border-radius:6px;background:var(--surface)}

  /* CTA */
  .cta{background:linear-gradient(160deg,var(--navy),var(--navy-2));color:#EAF2F5;text-align:center}
  .cta h2{font-size:clamp(2.1rem,4.6vw,3.4rem);color:#F5FAFB;font-weight:500}
  .cta h2 em{font-style:italic;color:var(--pearl-lt)}
  .cta p{color:#B9CED7;max-width:52ch;margin:16px auto 30px}
  .btn{display:inline-block;background:var(--coral);color:#fff;font-weight:600;
    padding:15px 34px;border-radius:3px;letter-spacing:.04em;font-size:.98rem}
  .btn:hover{background:var(--coral-dp)}
  .foot{background:var(--navy);color:#7C97A3;text-align:center;padding:30px 0;font-size:.82rem;
    border-top:1px solid rgba(255,255,255,.1)}
  .foot .mark{color:#EAF2F5;font-size:1.1rem;display:block;margin-bottom:6px}
  @media (prefers-reduced-motion: no-preference){
    .reveal{opacity:1}
  }
</style>
</head>
<body>

<div class="bar"><div class="wrap">
  <span class="mark">PERLAZUL</span>
  <a class="meta" href="https://juanjosegiraldoseo.github.io/SEO-EXPERT-Colombia/" target="_blank" rel="noopener" style="color:var(--muted)">Auditoría SEO · Juan José Giraldo</a>
</div></div>

<header class="hero">
  <div class="wrap">
    <span class="eyebrow">Auditoría SEO técnica · Septiembre 2026</span>
    <h1>Denim con alma.<br>Ahora que el mundo<br><em>lo encuentre.</em></h1>
    <p class="lede">PERLAZUL construyó una tienda hermosa, artesanal y con voz propia. El problema no es el producto: es que Google y los buscadores con IA todavía no la ven. Esto es lo que encontramos —y lo que podemos hacer al respecto.</p>
    <div class="heroStats">
